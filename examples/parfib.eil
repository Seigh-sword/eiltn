$ recursive fib: the two calls are independent ein nodes
$ so they are dispatched in the same wave, on worker threads
$ run with: eiltn parfib.eil -t 4

fn fib(n) {
    if n < 2 {
        return n
    }
    let a = fib(n - 1)
    let b = fib(n - 2)
    return a + b
}

fn main() {
    let t0 = clock()
    let r = fib(20)
    out.printf("fib(20) = %d\n", r)
    let t1 = clock()
    out.printf("nanos: %d\n", t1 - t0)
}
