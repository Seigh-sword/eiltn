$ fizzbuzz over a for loop

fn main() {
    for let i = 1; i <= 20; i = i + 1 {
        if i % 15 == 0 {
            println("fizzbuzz")
        } else if i % 3 == 0 {
            println("fizz")
        } else if i % 5 == 0 {
            println("buzz")
        } else {
            println(i)
        }
    }
}
